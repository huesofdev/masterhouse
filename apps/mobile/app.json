{
  "expo": {
    "name": "Master House",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "lk.masterhouse.pos",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Master House to use your location."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Master House to access your camera for barcode scanning and NIC capture."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Master House to access your photos to select NIC images.",
          "cameraPermission": "Allow Master House to access your camera to capture NIC images."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/icon.png",
          "resizeMode": "contain",
          "imageWidth": 150
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f430e6ff-260c-4475-ac13-9e97c0ead6f1"
      }
    },
    "owner": "huesofdev"
  }
}
